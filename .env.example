# ---------- Frontend (Cloudflare Pages) ----------
# رابط الباك إند على Render متبوعاً بـ /api
# اتركه فاضي في التطوير المحلي (بيشتغل عبر proxy في vite.config.js)
VITE_API_URL=https://your-backend.onrender.com/api

# اختياري: صور المنتجات والمدونة صارت روابط كاملة من Supabase Storage
# (السيرفر بيرجعها جاهزة بالـ API)، فما بتحتاج تضبط هالمتغير عادةً.
# VITE_MEDIA_URL=https://xxxx.supabase.co/storage/v1/object/public/uploads

# مفتاح Moyasar العام (publishable) — آمن ينحط هون
VITE_MOYASAR_PUBLISHABLE_KEY=pk_test_xxxxxxxx
