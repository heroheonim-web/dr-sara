# ---------- Backend (Render) ----------
PORT=5000

# رابط قاعدة بيانات Supabase (Connection Pooler — Session mode)
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# سر توقيع الـ JWT — لازم يكون طويل وعشوائي
# توليد: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# روابط الفرونت إند المسموح لها (CORS) — افصل بينها بفاصلة
# (رابط Cloudflare Pages + الدومين المخصص إن وجد)
FRONTEND_URL=https://your-site.pages.dev,https://www.your-domain.com

# ---------- Supabase Storage (صور المنتجات والمدونة) ----------
# من لوحة Supabase → Project Settings → API
SUPABASE_URL=https://xxxx.supabase.co
# استخدم service_role key (سرّي، وليس anon key) — لازم صلاحيات كتابة على الـ bucket
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# اسم الـ bucket (أنشئه من Supabase → Storage، واجعله Public)
SUPABASE_STORAGE_BUCKET=uploads

# Moyasar
MOYASAR_API_KEY=sk_test_xxxxxxxx
MOYASAR_WEBHOOK_SECRET=your-webhook-secret

# عدد محاولات تسجيل الدخول المسموحة خلال 15 دقيقة (اختياري)
LOGIN_RATE_LIMIT=10
